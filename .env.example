# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
# Local SQLite (development only)
# DATABASE_URL=sqlite:///./dptech.db

# AWS Aurora PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://dptech:<password>@<aurora-writer-endpoint>:5432/dptech_db

# PostgreSQL on EC2 (simpler/cheaper)
# DATABASE_URL=postgresql://dptech:<password>@localhost:5432/dptech_db

DATABASE_URL=sqlite:///./dptech.db

# Set to true when using RDS/Aurora (enforces SSL)
DB_SSL_REQUIRED=false

# ─────────────────────────────────────────────
# SECURITY  — MUST be changed in production
# ─────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─────────────────────────────────────────────
# COMPANY INFO
# ─────────────────────────────────────────────
COMPANY_NAME=DATAPOINT Technologies
COMPANY_ADDRESS=G 32 Shayas Residence Jamshoro Road, Hyderabad Sindh
COMPANY_PHONE=+92-XXX-XXXXXXX
COMPANY_EMAIL=info@datapointtechnology.com
COMPANY_WEBSITE=http://datapointtechnology.com
COMPANY_NTN=XXXXXXXXXXXXX
COMPANY_STRN=XXXXXXXXXXXXX
SALES_TAX_RATE=17.0

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
PORT=8000
PDF_OUTPUT_DIR=./pdf_output

# Comma-separated allowed CORS origins (e.g. https://app.example.com).
# Leave empty to deny all cross-origin requests. Set to "*" to allow any (no credentials).
CORS_ORIGINS=

# First admin account — created automatically only when the database has NO users.
# REQUIRED in production. If unset, no admin is created and you must add one manually.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# ─────────────────────────────────────────────
# EMAIL  (optional)
# ─────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ─────────────────────────────────────────────
# WHATSAPP  (optional)
# ─────────────────────────────────────────────
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ─────────────────────────────────────────────
# AI  (optional)
# ─────────────────────────────────────────────
OPENAI_API_KEY=
