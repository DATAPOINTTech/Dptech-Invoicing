# ========================================================
# Enterprise White-Label Invoicing Suite - Environment Configuration
# Copy this file to .env and configure for your company.
# ========================================================

APP_ENV=production
APP_DEBUG=false

# --------------------------------------------------------
# 1. DATABASE CONFIGURATION (Choose One)
# --------------------------------------------------------
# Option A: MySQL / MariaDB (Standard for cPanel & Cloud VPS Hosting)
# DATABASE_URL=mysql://dbuser:dbpassword@127.0.0.1:3306/company_invoicing

# Option B: SQLite (Single Server / Zero-Config Plug-and-Play)
DATABASE_URL=sqlite:///./storage/company.db

# Option C: PostgreSQL
# DATABASE_URL=postgresql://dbuser:dbpassword@127.0.0.1:5432/company_invoicing

# --------------------------------------------------------
# 2. INITIAL MASTER ADMINISTRATOR SETUP
# (Created automatically on first boot if database has no users)
# --------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=Admin@12345678

# --------------------------------------------------------
# 3. COMPANY WHITE-LABEL BRANDING & DETAILS
# (Can also be customized dynamically in the Web Admin panel at /settings)
# --------------------------------------------------------
COMPANY_NAME="Your Company Name"
BRAND_NAME="COMPANY"
COMPANY_TAGLINE="Invoicing & Quotation Suite"
COMPANY_LOGO="/static/img/logo.png"
COMPANY_FAVICON="/static/img/favicon.svg"

COMPANY_ADDRESS="Your Registered Business Address, City, Country"
COMPANY_CITY="Your City"
COMPANY_PHONE="+1 234 567 8900"
COMPANY_MOBILE="+1 234 567 8901"
COMPANY_WHATSAPP="+12345678901"
COMPANY_EMAIL="billing@yourcompany.com"
COMPANY_WEBSITE="https://yourcompany.com"

# Default Currency & Taxes
DEFAULT_CURRENCY="USD"
CURRENCY_SYMBOL="$"
DEFAULT_TAX_RATE=0.0
TAX_LABEL="Tax"

# --------------------------------------------------------
# 4. SECURITY & AUTHENTICATION TOKENS
# --------------------------------------------------------
# Long random secret (at least 32 characters) used to sign JWT auth tokens.
# If left empty, the application generates a secure persistent key in storage/.app_secret
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --------------------------------------------------------
# 5. MESSAGING GATEWAYS
# --------------------------------------------------------
# WhatsApp Dispatch Gateway
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=local
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_KEY=

# Corporate SMTP Email
EMAIL_HOST=mail.yourcompany.com
EMAIL_PORT=587
EMAIL_USER=invoices@yourcompany.com
EMAIL_PASS=
EMAIL_FROM=invoices@yourcompany.com
# SMTP_VERIFY_TLS=true

# --------------------------------------------------------
# 6. REGIONAL & LIVE RATES INTEGRATIONS
# --------------------------------------------------------
# Google Sheets Live Rates Sync URL
LIVE_RATE_SHEET_URL=

# Pakistan FBR POS / Digital Invoicing (Set false/disabled if outside Pakistan)
FBR_ENABLED=false
FBR_POS_ID=
FBR_BEARER_TOKEN=
FBR_ENVIRONMENT=sandbox
FBR_MODE=simulation
