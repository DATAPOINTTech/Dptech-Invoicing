# ========================================================
# cPanel Production Environment Configuration (template)
# Copy this file to .env in your cPanel app folder and fill in YOUR values.
# Never commit a .env that contains real passwords or keys.
# ========================================================

# OPTION A: MySQL on cPanel (use the credentials from cPanel -> MySQL Databases)
# DATABASE_URL=mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/DB_NAME

# OPTION B: SQLite on cPanel (if you prefer not using MySQL)
DATABASE_URL=sqlite:///./storage/dptech.db

# Security: long random secret (at least 32 characters) used to sign login tokens.
# Generate one with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial admin account (used only when the database has no users).
# Choose a strong password (8+ characters); do not reuse a shared or default one.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Company Details
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=Street, City, Country
COMPANY_PHONE=+000000000000
COMPANY_MOBILE=+000000000000
COMPANY_EMAIL=info@example.com

# Email / SMTP Configuration
EMAIL_HOST=mail.example.com
EMAIL_PORT=587
EMAIL_USER=info@example.com
EMAIL_PASS=
