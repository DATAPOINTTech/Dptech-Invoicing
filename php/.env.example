# ========================================================
# Enterprise White-Label Invoicing Suite - Environment Configuration
# Copy this file to .env and configure for your company.
# ========================================================

APP_ENV=production
APP_DEBUG=false

# 1. DATABASE CONFIGURATION
# MySQL: DATABASE_URL=mysql://dbuser:dbpassword@127.0.0.1:3306/company_invoicing
DATABASE_URL=sqlite:///./storage/company.db

# 2. MASTER ADMINISTRATOR
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=Admin@12345678

# 3. WHITE LABEL BRANDING
COMPANY_NAME="Your Company Name"
BRAND_NAME="COMPANY"
COMPANY_TAGLINE="Invoicing & Quotation Suite"
COMPANY_LOGO="/static/img/logo.png"
COMPANY_FAVICON="/static/img/favicon.svg"

COMPANY_ADDRESS="Your Registered Business Address, City, Country"
COMPANY_CITY="Your City"
COMPANY_PHONE="+1 234 567 8900"
COMPANY_MOBILE="+1 234 567 8901"
COMPANY_WHATSAPP="+12345678901"
COMPANY_EMAIL="billing@yourcompany.com"
COMPANY_WEBSITE="https://yourcompany.com"

DEFAULT_CURRENCY="USD"
CURRENCY_SYMBOL="$"
DEFAULT_TAX_RATE=0.0
TAX_LABEL="Tax"

# 4. SECURITY TOKENS
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 5. MESSAGING GATEWAYS
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=local
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_KEY=

EMAIL_HOST=mail.yourcompany.com
EMAIL_PORT=587
EMAIL_USER=invoices@yourcompany.com
EMAIL_PASS=
EMAIL_FROM=invoices@yourcompany.com

# 6. INTEGRATIONS
LIVE_RATE_SHEET_URL=
FBR_ENABLED=false
FBR_POS_ID=
FBR_BEARER_TOKEN=
FBR_ENVIRONMENT=sandbox
FBR_MODE=simulation
