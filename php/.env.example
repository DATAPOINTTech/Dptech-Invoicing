# Copy this file to .env and fill in your own values. Never commit .env.

DATABASE_URL=sqlite:///./storage/dptech.db

# Long random secret used to sign login tokens (at least 32 characters).
# Generate one with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# If left empty, the app creates its own random secret in storage/.app_secret.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

COMPANY_NAME="DATAPOINT Technologies"
COMPANY_ADDRESS="G 32 Shayas Residence, Jamshoro Road, Hyderabad, Sindh"
COMPANY_PHONE="+92 22 3669326"
COMPANY_MOBILE="+923712566540"
COMPANY_WHATSAPP="+923712566540"
COMPANY_EMAIL="sales@datapoinittechnology.com"
COMPANY_WEBSITE="https://datapointtechnology.com"

EMAIL_HOST=mail.example.com
EMAIL_PORT=587
EMAIL_USER=info@example.com
EMAIL_PASS=
# Certificates of the mail server are checked. Only set this to false if your host's mail
# certificate does not match EMAIL_HOST and you cannot fix it.
# SMTP_VERIFY_TLS=true

WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
# Shared secret between the app and the WhatsApp service (16+ characters).
# If left empty, both create/use storage/.bridge_secret automatically.
# WHATSAPP_BRIDGE_SECRET=
