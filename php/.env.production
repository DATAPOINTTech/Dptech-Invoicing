# Production environment template. Copy to .env on the server and fill in real values.
# Never commit a .env that contains real passwords or keys.
APP_ENV=production
COMPANY_NAME="DATAPOINT Technologies"
COMPANY_ADDRESS="G 32 Shayas Residence, Jamshoro Road, Hyderabad, Sindh"
COMPANY_PHONE="+92 22 3669326"
COMPANY_MOBILE="+923712566540"
COMPANY_WHATSAPP="+923712566540"
COMPANY_EMAIL="sales@datapoinittechnology.com"
COMPANY_WEBSITE="https://datapointtechnology.com"

# Security: long random secret (at least 32 characters) used to sign login tokens.
# Generate one with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (Choose one)
# 1. PostgreSQL (Recommended for cloud/production)
# DATABASE_URL=postgresql://dbuser:dbpassword@localhost:5432/dptech_prod
# 2. MySQL
# DATABASE_URL=mysql://dbuser:dbpassword@localhost:3306/dptech_prod
# 3. SQLite (Single-server deployment)
DATABASE_URL=sqlite:///./storage/dptech.db

# Admin Account Seed (created on first run if the database is empty).
# Choose a strong password (8+ characters). Do not use a shared or default password.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Email / SMTP Configuration
EMAIL_HOST=mail.example.com
EMAIL_PORT=465
EMAIL_USER=info@example.com
EMAIL_PASS=
EMAIL_FROM=info@example.com
# SMTP_VERIFY_TLS=true

# WhatsApp Messaging Gateway
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=local
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BRIDGE_SECRET=
